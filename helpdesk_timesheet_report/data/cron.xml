<odoo>
        <data noupdate="1">

    <record id="ir_cron_weekly_helpdesk_report" model="ir.cron">
        <field name="name">Weekly Helpdesk Report</field>
        <field name="model_id" ref="helpdesk.model_helpdesk_ticket"/>
        <field name="state">code</field>
        <field name="code">model.send_weekly_report()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">weeks</field>
        <field name="active">True</field>
    </record>

      <record id="helpdesk_timesheet_report_email_to" model="ir.config_parameter">

        <field name="key">helpdesk_timesheet_report.email_to</field>

        <field name="value">client@example.com</field>

      </record>
        </data>

</odoo>